{erl_opts, [debug_info]}.

{deps, [
    {cowboy, "2.12.0"},
    {jsx, "3.1.0"}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [citas_medicas]}
]}.

{relx, [
    {release, {citas_medicas, "0.1.0"}, [citas_medicas, sasl]},
    {mode, dev},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod}, {include_erts, true}]}]}
]}.
