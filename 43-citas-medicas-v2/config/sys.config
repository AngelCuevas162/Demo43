[
 {citas_medicas, [
    {puerto, 8081},
    %% archivo donde se guarda la agenda (sobrevive a reinicios). undefined = solo memoria
    {archivo_datos, "datos/citas.bin"},
    %% cada cuantos ms revisa si hay recordatorios por enviar
    {intervalo_ms, 30000},
    %% recordatorios a 48 h y 2 h antes (en segundos)
    {ventana_r48_seg, 172800},
    {ventana_r2_seg, 7200},
    %% intentos de entrega antes de marcar un recordatorio como fallido
    {max_intentos, 3},
    %% probabilidad (0.0 a 1.0) de que falle la entrega: inyeccion de fallas
    {prob_fallo_entrega, 0.0}
 ]},
 {kernel, [{logger_level, info}]}
].
